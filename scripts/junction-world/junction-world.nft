#!/usr/sbin/nft -f

flush ruleset

table inet junction_world {
    set research_ipv4 {
        type ipv4_addr
        flags timeout
        timeout 30s
    }

    chain input {
        type filter hook input priority 0; policy drop;
        iifname "lo" accept
        ct state established,related accept
        iifname "enp0s3" ip saddr 10.0.2.2 tcp dport 43130 ct state new accept
        iifname "enp0s3" ip saddr 10.0.2.2 udp sport 67 udp dport 68 accept
    }

    chain output {
        type filter hook output priority 0; policy drop;
        oifname "lo" accept
        ct state established,related accept
        oifname "enp0s3" udp sport 68 udp dport 67 accept
        meta skuid 0 ip daddr 10.0.2.3 udp dport 53 accept
        meta skuid @RESEARCH_UID@ ip daddr @research_ipv4 tcp dport 443 accept
    }
}
