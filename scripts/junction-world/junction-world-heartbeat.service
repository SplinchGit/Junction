[Unit]
Description=Persistent Junction World cognition runtime
After=junction-world.service
Requires=junction-world.service
StartLimitIntervalSec=300s
StartLimitBurst=5

[Service]
Type=simple
User=junction
Group=junction
WorkingDirectory=/home/junction/junction
Environment=HOME=/home/junction
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -I -B /usr/lib/junction-world/agent.py
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=40
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/junction/junction
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=768M
CPUQuota=80%
TasksMax=64
LimitFSIZE=33554432
LimitNOFILE=128
LimitNPROC=64
StandardOutput=journal
StandardError=journal
