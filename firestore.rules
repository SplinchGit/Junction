rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function validProvenance(value) { return value in ['OWNER', 'JUNCTION', 'UNTRUSTED']; }

    match /users/{userId} {
      allow read, write: if ownsUser(userId);

      match /conversations/{conversationId} {
        allow read, write: if ownsUser(userId);

        match /messages/{messageId} {
          allow read, delete: if ownsUser(userId);
          allow create, update: if ownsUser(userId)
            && request.resource.data.keys().hasOnly([
              'id', 'role', 'content', 'createdAt', 'provenance', 'sourceRef'
            ])
            && request.resource.data.role in ['USER', 'ASSISTANT', 'SYSTEM', 'user', 'assistant', 'system']
            && request.resource.data.content is string
            && request.resource.data.provenance == 'UNTRUSTED'
            && request.resource.data.sourceRef is string;
        }
      }

      match /feed_items/{itemId} {
        allow read, write: if ownsUser(userId);
      }

      // §4.3 read-only audit mirror: field-limited (no argumentsJson/planText
      // ever leaves the device) and append-only — never deletable, matching
      // the local action_log's own append-only contract.
      match /audit_log/{entryId} {
        allow read: if ownsUser(userId);
        allow create, update: if ownsUser(userId)
          && request.resource.data.keys().hasOnly([
            'id', 'timestamp', 'toolName', 'decision', 'outcome', 'riskTier', 'blockReason'
          ]);
        allow delete: if false;
      }

      match /preferences/{preferenceId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && preferenceId == 'main'
          && request.resource.data.keys().hasOnly(['chatModel'])
          && request.resource.data.chatModel is string
          && request.resource.data.chatModel.size() > 0
          && request.resource.data.chatModel.size() <= 120;
        // Replacement also acts as a one-time migration that removes fields
        // synced by older clients (device permissions/endpoints/integrations).
        allow update: if ownsUser(userId)
          && preferenceId == 'main'
          && request.resource.data.keys().hasOnly(['chatModel'])
          && request.resource.data.chatModel is string
          && request.resource.data.chatModel.size() > 0
          && request.resource.data.chatModel.size() <= 120;
        allow delete: if false;
      }

      // v1 authoritative shared history. Messages are immutable facts. Synced
      // history is context only and never enters /remote_commands.
      match /shared_conversations/{conversationId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && request.resource.data.keys().hasOnly(['id','title','createdAt','updatedAt','createdByDeviceId','schemaVersion','deletedAt'])
          && request.resource.data.id == conversationId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 80
          && request.resource.data.createdAt is int
          && request.resource.data.updatedAt is int
          && request.resource.data.schemaVersion == 1
          && request.resource.data.createdByDeviceId is string
          && request.resource.data.createdByDeviceId.size() <= 160
          && (!('deletedAt' in request.resource.data) || request.resource.data.deletedAt == null || request.resource.data.deletedAt is int);
        allow update: if ownsUser(userId)
          && (
            request.resource.data == resource.data
            || (
              (!('deletedAt' in resource.data) || resource.data.deletedAt == null)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','updatedAt','deletedAt'])
              && request.resource.data.id == resource.data.id
              && request.resource.data.schemaVersion == resource.data.schemaVersion
              && request.resource.data.createdByDeviceId == resource.data.createdByDeviceId
              && request.resource.data.title is string
              && request.resource.data.title.size() <= 80
              && request.resource.data.updatedAt is int
              && (!('deletedAt' in request.resource.data) || request.resource.data.deletedAt == null || request.resource.data.deletedAt is int)
            )
          );
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if ownsUser(userId);
          allow create: if ownsUser(userId)
            && request.resource.data.keys().hasOnly(['id','role','content','createdAt','provenance','sourceRef','deviceId','schemaVersion'])
            && request.resource.data.id == messageId
            && request.resource.data.role in ['USER','ASSISTANT','SYSTEM','user','assistant','system']
            && request.resource.data.content is string
            && request.resource.data.content.size() <= 20000
            && validProvenance(request.resource.data.provenance)
            && request.resource.data.sourceRef is string
            && request.resource.data.sourceRef.size() <= 500
            && request.resource.data.deviceId is string
            && request.resource.data.deviceId.size() <= 160
            && request.resource.data.createdAt is int
            && request.resource.data.schemaVersion == 1;
          allow update: if ownsUser(userId) && request.resource.data == resource.data;
          allow delete: if false;
        }
      }

      // Owner-confirmed durable memory. Content/provenance never mutate; delete
      // is a tombstone so devices converge without resurrecting an old fact.
      match /shared_memory/{memoryId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && request.resource.data.keys().hasOnly(['id','content','category','createdAt','provenance','sourceRef','deviceId','schemaVersion','deletedAt'])
          && request.resource.data.id == memoryId
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 2000
          && request.resource.data.provenance == 'OWNER'
          && request.resource.data.sourceRef is string
          && request.resource.data.sourceRef.size() <= 500
          && request.resource.data.category is string
          && request.resource.data.category.size() <= 80
          && request.resource.data.createdAt is int
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId.size() <= 160
          && request.resource.data.schemaVersion == 1
          && (!('deletedAt' in request.resource.data) || request.resource.data.deletedAt == null || request.resource.data.deletedAt is int);
        allow update: if ownsUser(userId)
          && (
            request.resource.data == resource.data
            || (
              (!('deletedAt' in resource.data) || resource.data.deletedAt == null)
              && request.resource.data.deletedAt is int
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt'])
              && request.resource.data.id == resource.data.id
              && request.resource.data.content == resource.data.content
              && request.resource.data.provenance == resource.data.provenance
            )
          );
        allow delete: if false;
      }

      // Explicitly registered companion devices. Authentication proves the
      // Firebase owner; deviceId is a stable local identifier, not an authority
      // token. Provider credentials and raw PC context are never valid fields.
      match /devices/{deviceId} {
        allow read, delete: if ownsUser(userId);
        allow create, update: if ownsUser(userId)
          && request.resource.data.keys().hasOnly([
            'deviceId', 'name', 'platform', 'appVersion', 'syncEnabled',
            'createdAt', 'lastSeenAt', 'disabledAt'
          ])
          && request.resource.data.deviceId == deviceId
          && request.resource.data.platform in ['windows', 'android']
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.appVersion is string
          && request.resource.data.appVersion.size() <= 40
          && request.resource.data.syncEnabled is bool
          && request.resource.data.createdAt is timestamp
          && request.resource.data.lastSeenAt is timestamp
          && (!('disabledAt' in request.resource.data) || request.resource.data.disabledAt is timestamp);
      }

      // Separate from /conversations/{id}/messages on purpose: those are
      // always UNTRUSTED by rule, so they can never act as a command. A
      // command written here while authenticated as the owner is trusted
      // and runs through the normal chat pipeline -- see
      // RemoteCommandSyncManager.
      //
      // Limitation: Firestore rules authenticate the *owner*, not the
      // *device*. There is no rule-level way to tell the Android app's
      // client apart from the owner's own web client -- both hold the same
      // Firebase Auth identity. The boundary these rules enforce is field
      // scoping (which keys a write may touch, and what values are legal),
      // not "only the phone may claim/complete a command". That is
      // acceptable because both sides are the authenticated owner, but it
      // is not a substitute for a real device-identity check -- do not
      // treat it as one.
      match /remote_commands/{commandId} {
        allow read, delete: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && request.resource.data.keys().hasOnly(['content', 'status', 'createdAt', 'source'])
          && request.resource.data.content is string
          && request.resource.data.status == 'pending';
        // Lifecycle/result fields written after creation. 'status' is
        // restricted to non-initial values here -- only `create` may set
        // 'pending' -- so a client cannot rewind a command to re-trigger
        // execution. Result fields are intentionally coarse (see
        // RemoteCommandSyncManager): no tool arguments, plan text, or raw
        // provider output ever lands here.
        allow update: if ownsUser(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status', 'error', 'assistantResponse', 'toolsRequested',
              'toolsRan', 'approvalRequired', 'claimedAt', 'completedAt',
              'conversationId'
            ])
          && (
            !('status' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.status in ['processing', 'awaiting_approval', 'done', 'error']
          );
      }
    }
  }
}
