# Example environment for the backend
# Put real values into server/.env (do NOT commit your real API keys)

# Server-wide OpenAI key (optional). If absent, users must provide personal keys.
OPENAI_API_KEY=
PROVIDER=openai
MODEL=gpt-4o
PORT=3000

# Firebase admin service account JSON. Either set GOOGLE_APPLICATION_CREDENTIALS to a file path
# or paste the JSON here as a single-line string in FIREBASE_SERVICE_ACCOUNT_JSON.
# Example (not real):
# FIREBASE_SERVICE_ACCOUNT_JSON=$(cat ./service-account.json | base64 -w0)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Symmetric encryption key used to encrypt per-user provider keys in Firestore.
# Must be 32 bytes base64 (e.g. openssl rand -base64 32)
ENCRYPTION_KEY=

# Toggle: if true the server will simulate slight delays for chunking (debug/testing)
SIMULATE_CHUNKING=false
