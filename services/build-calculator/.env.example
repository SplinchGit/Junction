# Local server
PORT=4001

# eBay Developer App credentials (Browse API, application access token via
# client-credentials grant). Create an app at https://developer.ebay.com/my/keys
# and use the production App ID / Cert ID (not the sandbox pair).
EBAY_APP_ID=
EBAY_CERT_ID=

# eBay marketplace the Browse API searches against.
EBAY_MARKETPLACE=EBAY_GB
